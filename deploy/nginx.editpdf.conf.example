##
# editpdf : reverse proxy nginx de l'hôte (VPS) vers le conteneur Docker.
#
# Domaine : pdf.gregory-day.fr (à remplacer partout dans ce fichier en cas de changement).
#
# Mise en place, une seule fois :
#   1. DNS : un enregistrement A (et AAAA si IPv6) de pdf.gregory-day.fr vers le VPS.
#   2. Certificat Let's Encrypt (avant d'activer ce fichier, qui en a besoin) :
#        sudo certbot certonly --nginx -d pdf.gregory-day.fr
#      Le renouvellement automatique (timer certbot) réutilise ensuite ce plugin.
#   3. Activer la config :
#        sudo cp deploy/nginx.editpdf.conf.example /etc/nginx/sites-available/editpdf.conf
#        sudo ln -s /etc/nginx/sites-available/editpdf.conf /etc/nginx/sites-enabled/
#        sudo nginx -t && sudo systemctl reload nginx
#   4. Vérifier :
#        curl -I https://pdf.gregory-day.fr/api/health    (200, en-têtes helmet)
#
# Tout est transmis au conteneur : Express sert l'API ET le frontend, avec ses
# propres en-têtes de cache (assets immutables, sw.js et index.html revalidés)
# et de sécurité (helmet, HSTS compris). On ne les redéfinit pas ici, sinon
# ils seraient envoyés en double.
##

##
# 1. HTTP → HTTPS
##
server {
    listen 80;
    listen [::]:80;
    server_name pdf.gregory-day.fr;

    return 301 https://$host$request_uri;
}

##
# 2. HTTPS
##
server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name pdf.gregory-day.fr;

    ssl_certificate /etc/letsencrypt/live/pdf.gregory-day.fr/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/pdf.gregory-day.fr/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;

    # ----------------------------
    # Upload de PDF : nginx refuse par défaut tout corps de plus de 1 Mo
    # (413 renvoyé par nginx, sans le message JSON de l'app). Doit rester
    # au-dessus de UPLOAD_MAX_SIZE_MB (100 par défaut) + l'enveloppe multipart.
    # Si UPLOAD_MAX_SIZE_MB augmente dans le .env, augmenter ici aussi.
    # ----------------------------
    client_max_body_size 110m;
    # Upload lent depuis un mobile : délai entre deux paquets reçus.
    client_body_timeout 120s;

    # ----------------------------
    # Compression des réponses texte (Express ne compresse pas).
    # Les PDF et les images sont déjà compressés : pas dans la liste.
    # ----------------------------
    gzip on;
    gzip_proxied any;
    gzip_vary on;
    gzip_min_length 1024;
    gzip_types text/css application/javascript application/json
               application/manifest+json image/svg+xml;

    location / {
        # Port publié par docker-compose.yml, sur le loopback uniquement.
        proxy_pass http://127.0.0.1:3003;
        proxy_http_version 1.1;

        proxy_set_header Host $host;
        # IP réelle du client : Express lui fait confiance (trust proxy,
        # backend/server.js) pour le rate-limit du login.
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # Traitements longs (OCR, compression d’un gros PDF) : la réponse peut tarder.
        proxy_read_timeout 300s;
    }
}
