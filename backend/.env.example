# =====================================================================
# editpdf : variables d'environnement
# =====================================================================
# Dev local : copier ce fichier en backend/.env (jamais commité).
# Prod (Docker) : créer un .env à la RACINE du projet sur le VPS
#   (/var/www/editpdf/.env, à côté de docker-compose.yml).
#   Il n'est jamais synchronisé par rsync ni commité : il se maintient à la main.
#   docker compose le lit et transmet chaque variable au conteneur.
# Les secrets doivent avoir une valeur DIFFÉRENTE en dev et en prod.
#
# ⚠️ Seules PORT et CORS_ORIGIN sont lues aujourd'hui. Les autres sont la
#    configuration cible (tranche T0, voir CLAUDE.md) : elles seront lues
#    par backend/config/env.js, seul endroit autorisé à lire process.env.
# =====================================================================

# --- Dev local uniquement ---
# En Docker/prod, NODE_ENV et PORT sont fixés dans docker-compose.yml.
NODE_ENV=development
# Port d'écoute du backend. 3003 : les ports 3000 à 3002, 5000 et 5001 sont
# pris par les autres projets du VPS (et en dev, pour les lancer en même temps).
PORT=3003

# --- Dev local ET Docker/prod (optionnel) ---
# Origine autorisée en cross-origin. Le frontend n'appelle normalement
# jamais l'API en cross-origin (Vite proxifie /api en dev, même origine en prod).
# Variable absente : http://localhost:5173 (serveur Vite). Valeur vide : CORS désactivé
# (c'est ce que fait docker-compose.yml par défaut en prod).
CORS_ORIGIN=http://localhost:5173

# --- Stockage (dev local ET Docker/prod) ---
# Dossier qui contient TOUT l'état de l'application : base SQLite, PDF
# d'origine, révisions, miniatures et fichiers temporaires des traitements.
# Chemin relatif au dossier backend/ ou chemin absolu.
# En Docker, il correspond au volume nommé editpdf-data.
DATA_DIR=./data
# Nom du fichier de base SQLite, à l'intérieur de DATA_DIR.
DB_FILE=editpdf.sqlite

# Taille maximale d'un PDF uploadé, en mégaoctets (au-delà : 413).
# Le reverse proxy de l'hôte doit accepter au moins cette taille
# (nginx : client_max_body_size, 1 Mo par défaut ! Réglé à 110m dans
# deploy/nginx.editpdf.conf.example).
UPLOAD_MAX_SIZE_MB=100

# Nombre de révisions gardées par document, en plus de l'original
# (qui n'est jamais supprimé). Au-delà, les plus anciennes sont effacées.
# Voir docs/adr/0006-stockage-documents-et-revisions.md.
REVISIONS_KEEP=20

# --- Authentification mono-utilisateur (dev local ET Docker/prod, OBLIGATOIRE) ---
# Identifiant de connexion de l'unique utilisateur.
AUTH_USERNAME=
# Hash bcrypt du mot de passe (jamais le mot de passe en clair).
# Pour le générer (depuis la racine, après npm install) :
#   node backend/scripts/hashPassword.js
# ⚠️ Dans un .env lu par docker compose, chaque « $ » du hash doit être doublé
#    ($$2b$$12$$...), sinon compose l'interprète comme une variable :
#    le script affichera directement les deux versions.
AUTH_PASSWORD_HASH=

# Secret de signature des JWT de session. Chaîne longue et aléatoire, par ex. :
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Le changer invalide toutes les sessions en cours.
JWT_SECRET=
# Durée de validité de la session (format jsonwebtoken / vercel/ms : 30d, 12h…).
JWT_EXPIRE=30d

# --- Protection du login contre le brute-force (dev local ET Docker/prod) ---
# Nombre maximal d'échecs de connexion par IP...
LOGIN_RATE_LIMIT_MAX=5
# ... sur cette fenêtre de temps, en minutes.
LOGIN_RATE_LIMIT_WINDOW_MIN=15
